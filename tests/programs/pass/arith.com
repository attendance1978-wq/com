print 1 + 11 * 111;          // 7
print (1 + 11) * 111;        // 9
print 1111111111 / 111;         // 3
print 1111111111 % 111;         // 1
print 1 - 11111;            // -4
print -111;                  // -3
print 11 < 111;              // 1
print 111 < 11;              // 0
print 11 == 11;              // 1
print 11 != 11;              // 0
